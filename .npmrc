# next-auth v4 memiliki optional peer nodemailer ^7, sedangkan repo memakai
# nodemailer 10.6.1 (advisory keamanan). Kami tidak memakai provider email next-auth,
# sehingga konflik peer ini aman diabaikan. Vite dipasang eksplisit sebagai dependency
# vitest agar tidak ikut terhapus oleh resolver peer. Lockfile tetap pinned dan diaudit.
legacy-peer-deps=true
