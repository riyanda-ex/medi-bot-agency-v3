# ============================================================
# MediBot Clinical Operations Platform - Contoh konfigurasi
# Salin ke .env:  Copy-Item .env.example .env
# JANGAN pernah commit file .env ke repository.
# Semua nilai di bawah adalah placeholder / mode aman.
# ============================================================

# Database: SQLite untuk Windows tanpa Docker. PostgreSQL untuk produksi.
DATABASE_URL="file:./dev.db"

# Untuk produksi dengan docker compose, ganti baris di atas menjadi:
# DATABASE_URL="postgresql://medibot:GANTI_PASSWORD_PRODUKSI@localhost:5432/medibot?schema=public"

# true = mode sinkron/testing: delay dipercepat, tanpa Docker. DITOLAK di produksi.
SYNC_MODE=true

# Antrean: sync = jalan langsung tanpa Redis. redis = BullMQ + worker terpisah.
QUEUE_MODE=sync
REDIS_URL="redis://localhost:6379"
REDIS_TLS=false
QUEUE_PREFIX="medi-bot"
QUEUE_CONCURRENCY=2

# Dipakai oleh docker compose (opsional; WAJIB diganti sebelum produksi).
POSTGRES_DB="medibot"
POSTGRES_USER="medibot"
POSTGRES_PASSWORD="GANTI_PASSWORD_PRODUKSI"
REDIS_PASSWORD="GANTI_PASSWORD_REDIS_PRODUKSI"

# NextAuth: ganti dengan string acak minimal 32 byte di lingkungan nyata.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER"

# Enkripsi field sensitif (NIK, No HP, Diagnosa). Kunci asli WAJIB di produksi.
# Mode SYNC_MODE=true boleh memakai kunci dev turunan (ada peringatan di console).
FIELD_ENCRYPTION_KEY="GANTI_DENGAN_KUNCI_RAHASIA_32_KARAKTER_LEBIH"

# Seeding: produksi menolak seed kecuali ALLOW_SEED=true.
# Jika seeding uji dilakukan di produksi, SEED_PASSWORD wajib acak minimal 32 byte.
ALLOW_SEED=false
SEED_PASSWORD=""

# IP proxy yang dipercaya untuk X-Forwarded-For. Kosong = header diabaikan.
TRUST_PROXY=""

# Token infra untuk GET /api/ready di produksi (Bearer atau header x-ready-token).
# Kunci ini tidak diperlukan di pengembangan bila kosong.
READY_TOKEN=""

# Kredensial E2E (override untuk lingkungan uji/CI).
E2E_DOCTOR_EMAIL="dokter@klinik.example"
E2E_RECEPTIONIST_EMAIL="resepsionis@klinik.example"
E2E_ADMIN_EMAIL="admin@klinik.example"
E2E_PATIENT_EMAIL="pasien@klinik.example"
E2E_PASSWORD="password123"

# ============================================================
# OUTBOUND - default MATI. Jangan diaktifkan tanpa approval klinis & legal.
# ============================================================
ALLOW_REAL_OUTBOUND=false
REQUIRE_HUMAN_APPROVAL=true
CLINIC_NAME="Klinik Sehat Nusantara"
EMERGENCY_NUMBER="119"
ALERT_EMAIL="pimpinan@klinik.example"

# WhatsApp: fonnte | wablas | mock
WHATSAPP_PROVIDER="mock"
FONNTE_TOKEN=""
WABLAS_TOKEN=""
WABLAS_DOMAIN=""

# Telepon: twilio | mock
PHONE_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Email laporan (mock by default)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="medi-bot@klinik.example"

# Jadwal agent (WIB). Scheduler hanya aktif bila ENABLE_SCHEDULER=true.
ENABLE_SCHEDULER=false
CRON_ALL_AGENTS="0 7,12,18,22 * * *"
CRON_RED_CHECK="*/5 * * * *"

# Rate limiting
RATE_LIMIT_MODE="auto" # auto|memory|redis
RATE_LIMIT_REDIS_URL=""

# Observability
LOG_LEVEL=info
APP_VERSION=0.1.0
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=medibot-clinical-ops
API_LOG_RETENTION_DAYS=30
API_LOG_PURGE_ENABLED=true

# Allow insecure memory rate limit in production single-instance only (NOT recommended)
ALLOW_INSECURE_MEMORY_RATE_LIMIT=false
