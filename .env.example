# ============================================================
# MEDI-BOT AGENCY v3 - Contoh konfigurasi
# Salin ke .env:  Copy-Item .env.example .env
# JANGAN pernah commit file .env ke repository.
# Semua nilai di bawah adalah placeholder / mode aman.
# ============================================================

# Database: SQLite untuk Windows tanpa Docker. PostgreSQL untuk produksi.
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"

# Untuk produksi dengan docker compose, ganti dua baris di atas menjadi:
# DATABASE_URL="postgresql://medibot:GANTI_PASSWORD_PRODUKSI@localhost:5432/medibot?schema=public"
# DATABASE_PROVIDER="postgresql"

# true = mode sinkron/testing: provider mock, delay dipercepat, tanpa Docker.
SYNC_MODE=true

# Antrean: sync = jalan langsung tanpa Redis. redis = BullMQ + worker terpisah.
QUEUE_MODE=sync
REDIS_URL="redis://localhost:6379"
REDIS_TLS=false
QUEUE_PREFIX="medi-bot"
QUEUE_CONCURRENCY=2

# Dipakai oleh docker compose (opsional; ubah password sebelum produksi).
POSTGRES_DB="medibot"
POSTGRES_USER="medibot"
POSTGRES_PASSWORD="GANTI_PASSWORD_PRODUKSI"

# NextAuth: ganti dengan string acak minimal 32 karakter di lingkungan nyata.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER"

# Enkripsi field sensitif (NIK, No HP,Diagnosa). Kunci asli WAJIB di production.
# Mode SYNC_MODE=true boleh memakai kunci dev turunan (ada peringatan di console).
FIELD_ENCRYPTION_KEY="GANTI_DENGAN_KUNCI_RAHASIA_32_KARAKTER_LEBIH"

# ============================================================
# OUTBOUND - default MATI. Jangan diaktifkan tanpa approval klinis & legal.
# ============================================================
ALLOW_REAL_OUTBOUND=false
REQUIRE_HUMAN_APPROVAL=true
CLINIC_NAME="Klinik Sehat Nusantara"
EMERGENCY_NUMBER="119"
ALERT_EMAIL="pimpinan@klinik.example"

# WhatsApp: fonnte | wablas | mock
WHATSAPP_PROVIDER="mock"
FONNTE_TOKEN=""
WABLAS_TOKEN=""
WABLAS_DOMAIN=""

# Telepon: twilio | mock
PHONE_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Email laporan (mock by default)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="medi-bot@klinik.example"

# Jadwal agent (WIB). Scheduler hanya aktif bila ENABLE_SCHEDULER=true.
ENABLE_SCHEDULER=false
CRON_ALL_AGENTS="0 7,12,18,22 * * *"
CRON_RED_CHECK="*/5 * * * *"
