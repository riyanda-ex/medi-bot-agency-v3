{
  "name": "medibot-clinical-ops",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "riyanda-ex (https://github.com/riyanda-ex)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riyanda-ex/medi-bot-agency-v3.git"
  },
  "homepage": "https://github.com/riyanda-ex/medi-bot-agency-v3#readme",
  "bugs": {
    "url": "https://github.com/riyanda-ex/medi-bot-agency-v3/issues"
  },
  "description": "Secure-by-default multi-agent clinical operations platform for Indonesian clinics (Next.js, Prisma, RBAC, audit, queue).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:agents": "tsx scripts/verify-agents.ts",
    "queue:worker": "tsx scripts/queue-worker.ts",
    "e2e": "node scripts/e2e-check.mjs",
    "queue:check": "node scripts/queue-check.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:pg": "node scripts/sync-postgres-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run prisma:generate && npm run db:push && npm run db:seed",
    "db:push:pg": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:setup:pg": "npm run prisma:generate:pg && npm run db:push:pg && npm run db:seed",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "openapi:check": "node scripts/check-openapi.mjs",
    "verify:all": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run openapi:check"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@radix-ui/react-slot": "1.1.1",
    "bcryptjs": "2.4.3",
    "bullmq": "6.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "ioredis": "6.1.0",
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "node-cron": "4.6.0",
    "nodemailer": "10.6.1",
    "pdfkit": "0.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "2.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "10.4.20",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "8.5.33",
    "prettier": "^3.10.1",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
