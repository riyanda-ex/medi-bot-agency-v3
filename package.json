{
  "name": "medibot-clinical-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "riyanda-ex (https://github.com/riyanda-ex)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riyanda-ex/medi-bot-agency-v3.git"
  },
  "homepage": "https://github.com/riyanda-ex/medi-bot-agency-v3#readme",
  "bugs": {
    "url": "https://github.com/riyanda-ex/medi-bot-agency-v3/issues"
  },
  "description": "Secure-by-default multi-agent clinical operations platform for Indonesian clinics (Next.js, Prisma, RBAC, audit, queue).",
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:7": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "verify:agents": "tsx scripts/verify-agents.ts",
    "queue:worker": "tsx scripts/queue-worker.ts",
    "e2e": "node scripts/e2e-check.mjs",
    "queue:check": "node scripts/queue-check.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:pg": "node scripts/sync-postgres-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:deploy:pg": "prisma migrate deploy --config prisma/postgres.config.ts",
    "db:backup:pg": "node scripts/backup-postgres.mjs",
    "db:restore:pg": "node scripts/restore-postgres.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run prisma:generate && npm run db:push && npm run db:seed",
    "db:push:pg": "prisma db push --config prisma/postgres.config.ts",
    "db:setup:pg": "npm run prisma:generate:pg && npm run db:push:pg && npm run db:seed",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "openapi:check": "node scripts/check-openapi.mjs",
    "verify:all": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:7 && npm run test && npm run build && npm run openapi:check"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "8.1.0-dev.12",
    "@prisma/adapter-pg": "8.1.0-dev.12",
    "@prisma/client": "8.1.0-dev.12",
    "@radix-ui/react-slot": "1.5.0",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.2.0",
    "bullmq": "6.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "18.0.10",
    "exceljs": "4.4.0",
    "ioredis": "6.1.0",
    "lucide-react": "1.82.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "node-cron": "4.6.0",
    "nodemailer": "10.6.1",
    "pdfkit": "0.21.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "effect": "3.22.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.11",
    "@types/nodemailer": "7.0.11",
    "@types/pdfkit": "0.17.3",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.1.0-dev.20261127.1",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "10.7.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.9",
    "postcss": "8.5.34",
    "prettier": "^3.10.1",
    "prisma": "8.1.0-dev.12",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
